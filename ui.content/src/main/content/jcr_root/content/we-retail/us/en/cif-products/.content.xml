<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="cq:Page">
    <jcr:content
        cq:catalogBlueprint="/content/catalogs/we-retail/en/website-catalog"
        cq:commerceProvider="we-retail"
        cq:cifCategoryPage="/content/we-retail/us/en/cif-products/category-page"
        cq:cifProductPage="/content/we-retail/us/en/cif-products/product-page"
        cq:cifSearchResultsPage="/content/we-retail/us/en/cif-products/search"
        cq:template="/conf/we-retail/settings/wcm/templates/hero-page"
        jcr:primaryType="cq:PageContent"
        jcr:title="CIF Products"
        showMainCategories="{Boolean}false"
        sling:resourceType="weretail/components/structure/catalogpage"
        navTitle="CIF Products">
        <root
            jcr:primaryType="nt:unstructured"
            sling:resourceType="wcm/foundation/components/responsivegrid">
            <hero_image
                jcr:primaryType="nt:unstructured"
                sling:resourceType="weretail/components/content/heroimage"
                fileReference="/content/dam/we-retail/en/products/Product_catalog.jpg"
                useFullWidth="true"/>
            <responsivegrid
                jcr:primaryType="nt:unstructured"
                sling:resourceType="wcm/foundation/components/responsivegrid">
                <title
                    jcr:primaryType="nt:unstructured"
                    jcr:title="Browse the CIF catalog"
                    sling:resourceType="weretail/components/content/title"
                    type="h2"/>
                <teaser
                    jcr:description="&lt;p>Explore products for women&lt;/p>&#xd;&#xa;"
                    jcr:primaryType="nt:unstructured"
                    jcr:title="For those who never stop"
                    sling:resourceType="weretail/components/content/teaser"
                    actionsEnabled="true"
                    descriptionFromPage="false"
                    fileReference="/content/dam/we-retail/en/activities/running/running-woods-woman.jpg"
                    textIsRich="true"
                    titleFromPage="false">
                    <cq:responsive jcr:primaryType="nt:unstructured">
                        <default
                            jcr:primaryType="nt:unstructured"
                            width="4"/>
                        <phone
                            jcr:primaryType="nt:unstructured"
                            width="12"/>
                    </cq:responsive>
                    <actions jcr:primaryType="nt:unstructured">
                        <item0
                            jcr:primaryType="nt:unstructured"
                            link="/content/we-retail/us/en/cif-products/category-page.html/wo.html"
                            text="Women"/>
                    </actions>
                </teaser>
                <teaser_1
                    jcr:description="&lt;p>Explore products for men&lt;/p>&#xd;&#xa;"
                    jcr:primaryType="nt:unstructured"
                    jcr:title="For those who challenge the elements"
                    sling:resourceType="weretail/components/content/teaser"
                    actionsEnabled="true"
                    descriptionFromPage="false"
                    fileReference="/content/dam/we-retail/en/activities/biking/rocks-downhill.jpg"
                    textIsRich="true"
                    titleFromPage="false">
                    <cq:responsive jcr:primaryType="nt:unstructured">
                        <default
                            jcr:primaryType="nt:unstructured"
                            width="4"/>
                        <phone
                            jcr:primaryType="nt:unstructured"
                            width="12"/>
                    </cq:responsive>
                    <actions jcr:primaryType="nt:unstructured">
                        <item0
                            jcr:primaryType="nt:unstructured"
                            link="/content/we-retail/us/en/cif-products/category-page.html/me.html"
                            text="Men"/>
                    </actions>
                </teaser_1>
                <teaser_2
                    jcr:description="&lt;p>Explore equipment&lt;/p>&#xd;&#xa;"
                    jcr:primaryType="nt:unstructured"
                    jcr:title="For the ones who want the strongest"
                    sling:resourceType="weretail/components/content/teaser"
                    actionsEnabled="true"
                    descriptionFromPage="false"
                    fileReference="/content/dam/we-retail/en/activities/climbing/climber-gear-rope.jpg"
                    textIsRich="true"
                    titleFromPage="false">
                    <cq:responsive jcr:primaryType="nt:unstructured">
                        <default
                            jcr:primaryType="nt:unstructured"
                            width="4"/>
                        <phone
                            jcr:primaryType="nt:unstructured"
                            width="12"/>
                    </cq:responsive>
                    <actions jcr:primaryType="nt:unstructured">
                        <item0
                            jcr:primaryType="nt:unstructured"
                            link="/content/we-retail/us/en/cif-products/category-page.html/eq.html"
                            text="Equipment"/>
                    </actions>
                </teaser_2>
            </responsivegrid>
        </root>
    </jcr:content>
    <category-page/>
    <product-page/>
    <search/>
</jcr:root>
