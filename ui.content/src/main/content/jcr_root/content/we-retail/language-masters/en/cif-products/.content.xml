<?xml version="1.0" encoding="UTF-8"?>
<jcr:root xmlns:sling="http://sling.apache.org/jcr/sling/1.0" xmlns:cq="http://www.day.com/jcr/cq/1.0" xmlns:jcr="http://www.jcp.org/jcr/1.0" xmlns:nt="http://www.jcp.org/jcr/nt/1.0"
    jcr:primaryType="cq:Page">
    <jcr:content
        cq:catalogBlueprint="/content/catalogs/we-retail/en/website-catalog"
        cq:commerceProvider="we-retail"
        cq:cifCategoryPage="/content/we-retail/language-masters/en/cif-products/category-page"
        cq:cifProductPage="/content/we-retail/language-masters/en/cif-products/product-page"
        cq:cifSearchResultsPage="/content/we-retail/language-masters/en/cif-products/search"
        cq:template="/conf/we-retail/settings/wcm/templates/section-page"
        hideInNav="{Boolean}true"
        jcr:primaryType="cq:PageContent"
        jcr:title="CIF Products"
        coverImage="/content/dam/we-retail/en/products/Product_catalog.jpg"
        showMainCategories="{Boolean}false"
        sling:resourceType="weretail/components/structure/catalogpage"
        navTitle="CIF Products">
        <root
            jcr:primaryType="nt:unstructured"
            sling:resourceType="wcm/foundation/components/responsivegrid">
            <responsivegrid
                jcr:primaryType="nt:unstructured"
                sling:resourceType="wcm/foundation/components/responsivegrid"/>
            <product-grid-container
                jcr:primaryType="nt:unstructured"
                sling:resourceType="wcm/foundation/components/responsivegrid">
                <product-filter
                    jcr:primaryType="nt:unstructured"
                    sling:resourceType="wcm/foundation/components/responsivegrid">
                    <productfilter-color
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="weretail/components/structure/productfilter"
                        type="color"/>
                    <productfilter-price
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="weretail/components/structure/productfilter"
                        type="price"/>
                    <productfilter-size
                        jcr:primaryType="nt:unstructured"
                        sling:resourceType="weretail/components/structure/productfilter"
                        type="size"/>
                </product-filter>
                <product-grid
                    category="/"
                    jcr:primaryType="nt:unstructured"
                    pageSize="{Long}200"
                    sling:resourceType="weretail/components/content/productgrid"/>
            </product-grid-container>
        </root>
    </jcr:content>
    <category-page/>
    <product-page/>
    <search/>
</jcr:root>
